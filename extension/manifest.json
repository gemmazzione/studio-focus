{
  "manifest_version": 3,
  "name": "Studio — blocco distrazioni",
  "version": "2.1.0",
  "description": "Blocca i social durante lo studio, i siti per adulti e la pubblicità di YouTube.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://samueleruggeri.altervista.org/*",
      "https://gemmazzione.github.io/*",
      "https://studio-focus-sam-221026.samurugge02.chatgpt.site/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult",
        "enabled": true,
        "path": "rules/adult.json"
      },
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
